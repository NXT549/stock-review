# Copy to .env and fill in. .env is git-ignored.
#
# This project runs NO AI/LLM itself. It produces a clean Markdown file you feed
# to an AI of your choice for review, so no AI provider API key is needed here.

# --- Optional paid data providers (disabled by default in config.yaml) ---
# These are the fields yfinance does NOT reliably provide for free
# (news/social sentiment, institutional flow). We do not fabricate them.
# Provide a key here AND flip the matching flag in config.yaml -> optional_providers.
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=

# --- Database (overrides config.yaml storage.db_url if set) ---
# SQLite default needs nothing. For PostgreSQL:
# STOCK_ANALYZER_DB_URL=postgresql+psycopg2://user:password@localhost:5432/stock_analyzer
STOCK_ANALYZER_DB_URL=
